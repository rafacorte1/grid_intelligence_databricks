{
  "datasets": [
    {
      "name": "operacao",
      "displayName": "Operação diária · últimos 30 dias",
      "queryLines": [
        "SELECT data, nome_conjunto, qtd_chamados, qtd_chamados_risco_saude,\n",
        "  uc_horas_interrompidas\n",
        "FROM painel_operacional_dia\n",
        "WHERE data >= date_sub((SELECT max(data) FROM painel_operacional_dia), 29)\n",
        "ORDER BY data, nome_conjunto"
      ]
    },
    {
      "name": "continuidade",
      "displayName": "DEC · mês mais recente",
      "queryLines": [
        "SELECT `Conjunto` AS nome_conjunto, `Mes` AS mes,\n",
        "  MEASURE(`DEC`) AS dec_horas\n",
        "FROM continuidade_metricas\n",
        "WHERE `Mes` = (SELECT max(mes_apuracao) FROM continuidade_conjunto_mes)\n",
        "GROUP BY ALL\n",
        "ORDER BY dec_horas DESC"
      ]
    },
    {
      "name": "acoes",
      "displayName": "Ações · último dia disponível",
      "queryLines": [
        "SELECT data, nome_conjunto, qtd_interrupcoes, qtd_chamados,\n",
        "  qtd_chamados_risco_saude, qtd_mencoes_ouvidoria, ucs_prioridade_alta, acao_recomendada\n",
        "FROM painel_operacional_dia\n",
        "WHERE data = (SELECT max(data) FROM painel_operacional_dia)\n",
        "  AND acao_recomendada <> 'Acompanhar operacao'\n",
        "ORDER BY qtd_chamados_risco_saude DESC, qtd_mencoes_ouvidoria DESC,\n",
        "  qtd_interrupcoes DESC, ucs_prioridade_alta DESC"
      ]
    },
    {
      "name": "inspecao",
      "displayName": "Evidências para visita técnica",
      "queryLines": [
        "SELECT id_uc, nome_conjunto, bairro, classe_consumo, prioridade_inspecao,\n",
        "  variacao_da_uc / 100.0 AS variacao_uc,\n",
        "  variacao_do_conjunto / 100.0 AS variacao_vizinhanca,\n",
        "  consumo_medio_baseline_kwh, consumo_medio_recente_kwh,\n",
        "  dias_no_baseline, dias_no_periodo_recente, motivo_observado, ultimo_dia\n",
        "FROM prioridade_inspecao_uc\n",
        "ORDER BY prioridade_inspecao ASC, variacao_da_uc ASC, id_uc"
      ]
    },
    {
      "name": "bairros",
      "displayName": "12 bairros com mais UCs candidatas na carga",
      "queryLines": [
        "SELECT nome_conjunto, bairro, prioridade_inspecao, count(*) AS ucs\n",
        "FROM prioridade_inspecao_uc\n",
        "WHERE bairro IN (\n",
        "  SELECT bairro FROM prioridade_inspecao_uc\n",
        "  GROUP BY bairro ORDER BY count(*) DESC, bairro LIMIT 12\n",
        ")\n",
        "GROUP BY ALL\n",
        "ORDER BY bairro, prioridade_inspecao"
      ]
    },
    {
      "name": "clientes",
      "displayName": "Clientes · risco alto de ouvidoria",
      "queryLines": [
        "SELECT id_cliente, nome_conjunto, bairro, qtd_chamados, qtd_ucs_com_chamado,\n",
        "  risco_ouvidoria, motivo_predominante, ultima_fala, ultimo_chamado_em\n",
        "FROM saude_cliente\n",
        "WHERE risco_ouvidoria = 'alto'\n",
        "ORDER BY qtd_mencoes_ouvidoria DESC, qtd_chamados DESC, id_cliente"
      ]
    },
    {
      "name": "inspecao_atual",
      "displayName": "Prioridade alta · fotografia atual",
      "queryLines": [
        "SELECT ultimo_dia AS data, nome_conjunto,\n",
        "  count_if(prioridade_inspecao = 'alta') AS ucs_prioridade_alta\n",
        "FROM prioridade_inspecao_uc\n",
        "GROUP BY ALL\n",
        "ORDER BY data, nome_conjunto"
      ]
    }
  ],
